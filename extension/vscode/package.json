{
  "name": "qidian-dashboard",
  "displayName": "奇点调度面板",
  "description": "奇点 Agent 调度平台 VS Code 扩展 — 任务监控、项目进度、实时事件流",
  "version": "0.1.0",
  "publisher": "qidian",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Other"],
  "activationEvents": ["onView:qidian.tasks", "onCommand:qidian.startLoop", "onCommand:qidian.stopLoop"],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "qidian": [
        {"id": "qidian.tasks", "name": "任务"},
        {"id": "qidian.projects", "name": "项目"},
        {"id": "qidian.agents", "name": "Agent"},
        {"id": "qidian.events", "name": "事件流"}
      ]
    },
    "viewsContainers": {
      "activitybar": [{
        "id": "qidian-sidebar",
        "title": "奇点调度",
        "icon": "$(server)"
      }]
    },
    "commands": [
      {"command": "qidian.submitTask", "title": "奇点: 提交任务"},
      {"command": "qidian.startLoop", "title": "奇点: 启动调度"},
      {"command": "qidian.stopLoop", "title": "奇点: 停止调度"},
      {"command": "qidian.refreshAll", "title": "奇点: 刷新全部"}
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node out/__tests__/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
